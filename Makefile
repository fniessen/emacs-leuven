EMACS ?= emacs

.DEFAULT_GOAL := help
ELISP_DIRS := lisp
ELISP_FILES := $(foreach dir,$(ELISP_DIRS),$(wildcard $(dir)/*.el))

.PHONY: help all tangle lint-shell test test-shell-utilities test-org-structure check check-parens check-links check-org-structure compile clean

# Show this help.
help:
	@printf '%s\n' "Usage: make TARGET" "" "Targets:"
	@awk '\
	/^[[:space:]]*#[[:space:]]/ { \
		description = $$0; \
		sub(/^[[:space:]]*#[[:space:]]*/, "", description); \
		next; \
	} \
	/^[a-zA-Z0-9_-]+:/ { \
		target = $$0; \
		sub(/:.*/, "", target); \
		printf "  %-15s %s\n", target, description; \
		description = ""; \
		next; \
	} \
	{ description = "" }' [Mm]akefile

# Run all validation and compilation targets.
all: lint-shell check compile

# Tangle every .org and .txt file in the repository.
tangle:
	$(EMACS) --batch --quick \
		--eval "\
(progn \
  (require 'org) \
  (require 'ob-tangle) \
  (dolist (file (directory-files-recursively default-directory \".*\")) \
    (when (member (file-name-extension file) '(\"org\" \"txt\")) \
      (message \"Tangling %s\" file) \
      (condition-case error \
          (with-temp-buffer \
            (insert-file-contents file) \
            (org-mode) \
            (setq buffer-file-name file) \
            (org-babel-tangle)) \
        (error \
         (message \"Failed to tangle %s: %s\" file (error-message-string error)))))))"

# Run ShellCheck on shell scripts in the repository.
lint-shell:
	@command -v shellcheck >/dev/null || { printf 'ShellCheck is required.\n' >&2; exit 127; }
	@find . -type f -not -path './.git/*' \
		\( -perm /111 -o -name '*.sh' -o -name '*.bash' \) -print0 \
		| xargs -0 -r grep -IlZ -m1 -E '^#!.*(bash|/sh|/dash|/ksh)([[:space:]]|$$)' \
		| xargs -0 -r shellcheck

# Run shell regression tests and ERT tests with Emacs-Leuven.
test: test-org-structure test-shell-utilities
	$(EMACS) --batch --quick -L lisp -L tests \
		-l lisp/emacs-leuven.el \
		-l tests/boost-wsl-clipboard-test.el \
		-l tests/latex-output-font-lock-test.el \
		-f ert-run-tests-batch-and-exit

# Run Org heading checker regression tests.
test-org-structure:
	bash tests/check-org-structure-test.sh

# Run Emacs shell utility regression tests.
test-shell-utilities:
	bash tests/shell-utilities-test.sh

# Run the source checks.
check: check-parens check-links check-org-structure

# Check parentheses in every Emacs Lisp source file.
check-parens:
	@$(EMACS) --batch --quick \
		--eval "\
(dolist (directory (list \"lisp\")) \
  (dolist (file (directory-files-recursively directory \"\\\\.el\\\\'\")) \
    (with-temp-buffer \
      (emacs-lisp-mode) \
      (message \"Checking %s\" file) \
      (insert-file-contents file) \
      (check-parens))))"

# Check HTTP(S) links in repository text files.
check-links:
	check-links

# Check Org heading levels, ignoring inline tasks at levels 15 and above.
check-org-structure:
	check-org-structure

# Byte-compile the Emacs Lisp source files.
compile:
	$(EMACS) --batch --quick -L lisp -L site-lisp -f batch-byte-compile $(ELISP_FILES)

# Remove generated byte-compiled and backup files.
clean:
	find $(ELISP_DIRS) -type f -name '*.elc' -delete
	find . -type f -name '*~' -delete
