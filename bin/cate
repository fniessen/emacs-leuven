#!/usr/bin/env bash

# Print the contents of the current buffer in Emacs to the terminal.

# Check if 'emacsclient' command is available.
if ! command -v emacsclient >/dev/null 2>&1; then
    printf "Error: 'emacsclient' command not found.\n" >&2
    exit 2
fi

if ! emacsclient -e '(server-running-p)' >/dev/null 2>&1; then
    printf "Error: Emacs server is not running. Please start the Emacs server first.\n" >&2
    exit 2
fi

pipe="$(mktemp -u)"
mkfifo "$pipe"
emacsclient -e '(with-current-buffer
                    (window-buffer (selected-window))
                  (write-region (point-min) (point-max) "'"$pipe"'" nil :quiet))
               ' >/dev/null &
cat "$pipe"                     # Handle files even without trailing newlines.
rm "$pipe"
