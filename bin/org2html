#!/usr/bin/env bash

if [ "$#" -ne 1 ]; then
    printf 'Usage: %s FILE.org\n' "${0##*/}" >&2
    exit 2
fi

if [ ! -f "$1" ]; then
    printf 'Error: not a regular file: %s\n' "$1" >&2
    exit 2
fi

start_time=$SECONDS

emacs --batch --quick "$1" \
    --eval "(progn
              (require 'package)
              (package-initialize)
              (require 'htmlize)
              (require 'ox-html)
              (setq org-export-with-smart-quotes t)
              (org-html-export-to-html))" &
export_pid=$!

# Show progress only when stderr is connected to a terminal, not redirected.
if [ -t 2 ]; then
    printf 'Exporting to HTML' >&2
    elapsed=0
    # Check each second for prompt completion; print a dot only every five seconds.
    while [[ " $(jobs -pr) " == *" $export_pid "* ]]; do
        sleep 1
        elapsed=$((elapsed + 1))
        if (( elapsed % 5 == 0 )) && [[ " $(jobs -pr) " == *" $export_pid "* ]]; then
            printf '.' >&2
        fi
    done
    printf '\n' >&2
fi

wait "$export_pid"
export_status=$?

# Keep the elapsed-time message out of redirected output too.
if [ -t 2 ]; then
    printf 'Export completed in %d seconds.\n' "$((SECONDS - start_time))" >&2
fi

exit "$export_status"
